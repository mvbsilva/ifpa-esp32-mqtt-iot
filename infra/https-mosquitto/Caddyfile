{$DOMAIN} {
    encode zstd gzip
    @mqtt path /mqtt /mqtt/*
    handle @mqtt {
        uri strip_prefix /mqtt
        reverse_proxy mosquitto:9001
    }
    handle {
        root * /srv
        file_server
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
            X-Frame-Options DENY
        }
    }
}
